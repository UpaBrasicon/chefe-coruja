# ─────────────────────────────────────────────────────────────────────────────
# HERMES — .env.prod.example
# Copie para .env.prod na VPS e preencha. NUNCA versionar (no git nem no
# docker compose de produção — o .dockerignore bloqueia o .env na imagem).
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Supabase (fonte da verdade) ──────────────────────────────────────────────
# A SERVICE_ROLE_KEY vive APENAS no .env.prod da VPS.
SUPABASE_URL=https://saqjrjtrkzkswsxxvdxn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# ── Canal WhatsApp ───────────────────────────────────────────────────────────
# Durante o teste com open-wa: deixe META_* com valores placeholder (o
# pipeline não envia até haver canal ativo).
# Na migração para a Meta oficial: preencha com as credenciais reais.
META_VERIFY_TOKEN=SEU_VERIFY_TOKEN
META_APP_SECRET=SEU_APP_SECRET
META_ACCESS_TOKEN=SEU_ACCESS_TOKEN
META_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID

# ── LLM — DeepSeek V4 Flash ──────────────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=SUA_CHAVE_DEEPSEEK

# ── LLM fallback — Kimi (opcional) ───────────────────────────────────────────
LLM_FALLBACK_BASE_URL=https://api.moonshot.ai/v1
LLM_FALLBACK_MODEL=kimi-k2.6
LLM_FALLBACK_API_KEY=

# ── Redis (interno ao compose — não mudar) ───────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Gavião (fiscal) — path do state.db do agente conversacional ──────────────
# Montado read-only via compose (volume /home/hermes/.hermes). Não mudar.
NOUS_DB_PATH=/opt/nous-data/state.db

# ── Identidade de teste ──────────────────────────────────────────────────────
HERMES_ORG_TESTE_ID=00000000-0000-0000-0000-000000000001

# ── Skill API (POST /skill/consulta) ─────────────────────────────────────────
# Gere com: openssl rand -hex 32
# O MESMO valor vai no ambiente do Nous como HERMES_SKILL_TOKEN.
SKILL_API_TOKEN=GERE_COM_openssl_rand_hex_32
