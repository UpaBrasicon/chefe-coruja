# ─────────────────────────────────────────────────────────────────────────────
# HERMES — Caddyfile (proxy reverso + HTTPS automático Let's Encrypt)
# Domínio hermes.chefecoruja.com.br com HTTPS automático (Let's Encrypt).
#
# Só /webhook (Meta) e /health ficam públicos. A API das skills (/skill/*) é
# usada pelo bot pela rede interna do Docker (hermes-app:3000) e NÃO passa por
# aqui — antes ela respondia na internet, em HTTP (auditoria 27/09).
# ─────────────────────────────────────────────────────────────────────────────

# HTTPS ligado em 02/10/2026 (DNS hermes.chefecoruja.com.br → 179.199.128.141).
# O acesso pelo IP em HTTP saiu: o Caddy redireciona o HTTP do domínio para HTTPS.
hermes.chefecoruja.com.br {
	@publico path /webhook /health
	handle @publico {
		# /webhook precisa do corpo BRUTO para validação HMAC — o Caddy repassa
		# o body sem alterações (não usamos compressão aqui).
		reverse_proxy app:3000
	}
	handle {
		respond 404
	}
	header -Server
}

# Biblioteca clínica do Chefe Coruja (28/09/2026): API em outro compose
# (/srv/biblioteca), container biblioteca-api na rede deploy_default.
# 179-199-128-141.sslip.io é o nome provisório até o DNS de
# biblioteca.chefecoruja.com.br apontar para este VPS.
biblioteca.chefecoruja.com.br, 179-199-128-141.sslip.io {
    reverse_proxy biblioteca-api:8710 {
        flush_interval -1
    }
    header -Server
}
