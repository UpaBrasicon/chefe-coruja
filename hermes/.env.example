# ─────────────────────────────────────────────────────────────────────────────
# HERMES — .env.example
# Copie para .env e preencha. NUNCA commitar o .env (está no .gitignore).
# Todas as variáveis exigidas falham rápido na inicialização (src/config/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase (fonte da verdade) ──────────────────────────────────────────────
# A SERVICE_ROLE_KEY vive APENAS aqui. Nunca em código, resposta de API ou log.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# ── Meta / WhatsApp Cloud API (a "boca" do Hermes) ───────────────────────────
# GET /webhook usa META_VERIFY_TOKEN no handshake da Meta.
# POST /webhook valida X-Hub-Signature-256 com HMAC-SHA256(META_APP_SECRET, raw body).
META_VERIFY_TOKEN=SUA_STRING_SECRETA_QUALQUER
META_APP_SECRET=SEU_META_APP_SECRET
META_ACCESS_TOKEN=SEU_TOKEN_DE_ACESSO
META_PHONE_NUMBER_ID=SEU_PHONE_NUMBER_ID

# ── LLM — DeepSeek V4 Flash (o "cérebro") ────────────────────────────────────
# Endpoint OpenAI-compatible. Modo thinking NÃO é usado no chat de rotina.
# Obs. custo: DeepSeek dobra a tarifa em pico 01:00–04:00 e 06:00–10:00 UTC
# (= 22:00–01:00 e 03:00–07:00 Brasília). JOB AGENDADO deve rodar FORA dessas
# janelas — ex.: resumo semanal às 07:30 Brasília, não às 07:00.
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=

# ── LLM fallback — Kimi K2.6 (OPCIONAL nesta fase) ───────────────────────────
# Se configurado, em 5xx/timeout repetido do provedor primário tenta 1x aqui.
LLM_FALLBACK_BASE_URL=https://api.moonshot.ai/v1
LLM_FALLBACK_MODEL=kimi-k2.6
LLM_FALLBACK_API_KEY=

# ── Redis (fila BullMQ) ───────────────────────────────────────────────────────
# Dentro do docker compose, o host é "redis" (nome do serviço).
REDIS_URL=redis://redis:6379

# ── Identidade de teste (do PREFLIGHT-HERMES.md) ─────────────────────────────
HERMES_ORG_TESTE_ID=00000000-0000-0000-0000-000000000001
