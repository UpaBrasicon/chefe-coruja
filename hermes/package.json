{
  "name": "gaviao",
  "version": "1.2.0",
  "private": true,
  "description": "Gavião — fiscal de segurança e assistente operacional do Chefe Coruja (DeepSeek V4 Flash)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --env-file=.env --import tsx --test --test-force-exit \"src/**/*.test.ts\"",
    "test:llm": "node --env-file=.env --import tsx src/lib/llm.ts",
    "seed:telefones": "tsx scripts/seed-telefones.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "bullmq": "^5.34.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.19.0",
    "globals": "^16.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0"
  }
}
