# ── HERMES .gitignore ─────────────────────────────────────────────────────────
# Segredos — NUNCA versionar
.env
.env.*
# Exceção: exemplos versionáveis (raiz e deploy/) — nunca os reais
!*.example

# Node
node_modules/
dist/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*

# Editor/OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
