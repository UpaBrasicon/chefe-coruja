# Dependências de ambiente
NEXT_PUBLIC_SITE_URL=https://chefecoruja.com.br

# Google Analytics 4 — Measurement ID (ex.: G-XXXXXXXXXX)
# TODO: substituir pelo GA4 real do negócio
NEXT_PUBLIC_GA_ID=

# (Removido) NEXT_PUBLIC_MAPS_KEY — o mapa usa embed keyless (output=embed),
# sem API key e sem exposição de billing (red-team V16).

# WhatsApp comercial (DDI + DDD + número)
NEXT_PUBLIC_WHATSAPP=5562999999999

# Formulário de contato (S10, H3): envia à Edge Function pedir-demonstracao do
# Supabase, que confere o Turnstile, o campo-isca e o limite de 3 por hora e
# manda o e-mail para contato@. Sem as duas variáveis abaixo, o formulário
# some e a página mostra o e-mail de contato.
# URL do projeto Supabase (a mesma do VITE_SUPABASE_URL do app), sem barra no fim.
NEXT_PUBLIC_SUPABASE_URL=
# Site key PÚBLICA do widget Turnstile (Cloudflare). O hostname deste site
# precisa estar na lista de domínios do widget. A secret fica só no Supabase
# (TURNSTILE_SECRET), nunca aqui.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
