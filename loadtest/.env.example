# Teste de carga: só HOMOLOGAÇÃO (kswurfyxxvfydpjfrivy). Copie para .env e preencha.
# O .env nunca vai para o git. Ver infra/teste-carga.md.
SUPABASE_URL=https://kswurfyxxvfydpjfrivy.supabase.co
# chave publicável (anon) da homologação: única chave que o k6 usa
SUPABASE_ANON_KEY=
# chave de serviço da homologação: só criar_massa.mjs e limpar_massa.mjs usam, nunca o k6
SUPABASE_SERVICE_ROLE_KEY=
# senha dos usuários carga-* (gere com: openssl rand -base64 24)
LOADTEST_SENHA=
