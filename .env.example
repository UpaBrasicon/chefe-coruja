# ── Cliente (exposto no navegador) ────────────────────────────────────────────
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# ── Integrações (NUNCA exponha no cliente) ────────────────────────────────────
# Estas chaves são usadas em Edge Functions do Supabase / env do servidor.
# Configure em: Dashboard do Supabase → Edge Functions → Secrets
#   (ou em Vercel → Project Settings → Environment Variables)

# Assinatura ICP-Brasil (Certificado A1 .pfx + senha)
# ICP_PFX_BASE64=
# ICP_PFX_SENHA=
# VIDaaS_ACCESS_TOKEN=

# WhatsApp Business API (Meta)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Envio de e-mail (deep links / avisos) — provedor SMTP ou Resend/SendGrid
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
