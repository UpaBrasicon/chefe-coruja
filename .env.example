# ── Cliente (exposto no navegador) ────────────────────────────────────────────
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON

# ── Scripts de importação (terminologia) — NUNCA exponha no cliente ───────────
# Usadas apenas em scripts locais/CI (scripts/terminologia/*.ts).
# A service_role key bypassa RLS — mantenha fora do bundle do frontend.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# ── Integrações (NUNCA exponha no cliente) ────────────────────────────────────
# Estas chaves são usadas em Edge Functions do Supabase / env do servidor.
# Configure em: Dashboard do Supabase → Edge Functions → Secrets
#   (ou em Vercel → Project Settings → Environment Variables)

# Assinatura ICP-Brasil (Certificado A1 .pfx + senha)
# ICP_PFX_BASE64=
# ICP_PFX_SENHA=
# VIDaaS_ACCESS_TOKEN=

# VIDaaS PSC (spike) — credenciais de HOMOLOGAÇÃO (nunca produção)
# usadas apenas por spikes/vidaas/vidaas-poc.ts
# VIDAAS_CLIENT_ID=
# VIDAAS_CLIENT_SECRET=
# VIDAAS_REDIRECT_URI=http://127.0.0.1:8765/callback
# VIDAAS_BASE_URL=
# VIDAAS_LIFETIME=5
# VIDAAS_SCOPE=signature_session
# VIDAAS_AUTHORIZE_ENDPOINT=/oauth/authorize
# VIDAAS_TOKEN_ENDPOINT=/oauth/token
# VIDAAS_SIGN_ENDPOINT=/signature

# WhatsApp Business API (Meta)
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Envio de e-mail (deep links / avisos) — provedor SMTP ou Resend/SendGrid
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
