# /etc/chefe-coruja/guarda.env no VPS — chmod 600, dono root. NUNCA no repositório.
# Guarda automática de 20 anos (Fase 0, tarefa 8). Ver infra/guarda/README.md.

# Banco: conta só de leitura (migration 20261025000001), pelo pooler de sessão.
# Usuário no formato guarda_leitura.<ref-do-projeto>; senha definida pelo responsável.
GUARDA_DB_URL=postgresql://guarda_leitura.saqjrjtrkzkswsxxvdxn:<SENHA>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave pública da guarda (a privada NUNCA vai para o servidor)
GUARDA_CHAVE_PUBLICA=/chaves/guarda-publica.pem

# Cofre: bucket S3 com Object Lock (conformidade, 20 anos) — usuário IAM guarda-envio
GUARDA_BUCKET=chefe-coruja-guarda-saqjrjt
GUARDA_REGIAO=sa-east-1
AWS_ACCESS_KEY_ID=<id da chave do guarda-envio>
AWS_SECRET_ACCESS_KEY=<segredo da chave do guarda-envio>

# Anexos (Storage) pelo protocolo S3 da Supabase: Storage → Settings → S3 Connection
GUARDA_STORAGE_S3_HOST=saqjrjtrkzkswsxxvdxn.storage.supabase.co
GUARDA_STORAGE_S3_REGIAO=sa-east-1
GUARDA_STORAGE_S3_ID=<access key id do S3 do Storage>
GUARDA_STORAGE_S3_SEGREDO=<secret access key do S3 do Storage>

# Alerta de falha/atraso por e-mail (Resend; chave só de envio)
RESEND_API_KEY=<chave do Resend, permissão "Sending access">
GUARDA_ALERTA_DE=Chefe Coruja <alertas@chefecoruja.com.br>
GUARDA_ALERTA_PARA=<seu e-mail>
GUARDA_VIGIA_HORAS=36
